# Set to "true" to route AI calls through the AWS integration layer instead of local simulations.
VITE_USE_AWS=false
VITE_AWS_REGION=eu-west-2
VITE_API_BASE_URL=https://api.example.com
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_SAGEMAKER_ENDPOINT=blendquoin-deviation-v1
VITE_BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
VITE_S3_DOCUMENT_BUCKET=blendquoin-documents

# Lead capture (demo request + contact forms). Leave empty and the forms open a pre-filled email instead.
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_GUID=
VITE_HUBSPOT_CONTACT_FORM_GUID=
